# ESP32-S3 target defaults - Moon Speaker (N16R8)
CONFIG_BOARD_ESP32S3_GENERIC=y

# Flash: 16 MB (N16R8). Use CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y for N8R2.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y


# Custom partition table (dual OTA + spiffs storage)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/boards/partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="components/boards/partitions.csv"

# PSRAM: OPI (Octal SPI) — 8MB on N16R8 / 2MB on N8R2
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# WebSocket support for /ws/leds LED animation endpoint
CONFIG_HTTPD_WS_SUPPORT=y

# AirPlay uses many concurrent sockets (RTSP, event, RTP, RTCP).
# 16 is too tight and causes "Failed to create UDP socket: errno=23".
CONFIG_LWIP_MAX_SOCKETS=32

# USB Audio Class (only used if AUDIO_OUTPUT_USB is selected)
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SAMPLE_RATE=48000

# I2S pins for MAX98357A (no MCLK needed)
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_BCK_IO=15
CONFIG_I2S_WS_IO=16
CONFIG_I2S_DO_IO=7
CONFIG_I2S_GND_IO=-1
CONFIG_I2S_VCC_IO=-1

# WS2812 LED animation strip
CONFIG_LED_ANIM_GPIO=10
CONFIG_LED_ANIM_COUNT=12

# Single-button media control: 1 click = play/pause, 2 = next, 3 = prev.
# Change BTN_PLAY_PAUSE_GPIO to your wired GPIO if not using BOOT (GPIO0).
CONFIG_BTN_SINGLE_BTN_MEDIA_CONTROL=y
CONFIG_BTN_PLAY_PAUSE_GPIO=0

# Audio buffer: 1000 frames for 8MB PSRAM (N16R8) — absorbs more WiFi jitter.
# Use 400 for 2MB PSRAM (N8R2).
CONFIG_AIRPLAY_AUDIO_BUFFER_FRAMES=1000

# --- Matter (ESP-Matter) ---
# Use ESP-IDF mDNS (shared with AirPlay on port 5353) instead of CHIP minimal mDNS.
# This prevents the critical port 5353 conflict between AirPlay and Matter.
CONFIG_USE_MINIMAL_MDNS=n

# Move Matter BSS segments to PSRAM to free internal RAM.
CONFIG_ESP_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
